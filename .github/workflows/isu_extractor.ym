name: ISU Jump Extractor Automated Run

on:
  schedule:
    - cron: '0 22 * * 0' # Automatically executes every Sunday at 22:00 UTC
  workflow_dispatch: # Allows manual run anytime from the UI

jobs:
  run-extractor:
    runs-on: ubuntu-latest
    
    # Required permissions to write output back to the repository
    permissions:
      contents: write

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run Extraction Script
        run: |
          python extract_jumps.py

      - name: Commit and push updated report
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add output_report.txt
          git commit -m "Auto-update ISU jump extraction report [skip ci]" || exit 0
          git push
